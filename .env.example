# Инструменты для сканирования (через запятую)
SCAN_SYMBOLS=EURUSD=X,GBPUSD=X,USDJPY=X,AUDUSD=X,USDCAD=X,EURGBP=X,USDCHF=X,EURJPY=X,GBPJPY=X,GC=F,SI=F,CL=F,BZ=F,NG=F,HG=F,PL=F,ES=F,NQ=F,BTC-USD,ETH-USD,ZN=F

# Интервал свечей и период истории
YFINANCE_INTERVAL=5m
YFINANCE_PERIOD=1mo

# Как часто сканировать (секунды)
POLL_INTERVAL_SEC=300

# Через сколько минут проверять точность (через запятую)
VERIFY_HORIZONS=15,30,60

LOG_LEVEL=INFO

# FxPro API (опционально, по умолчанию выключено — используется yfinance)
FXPRO_ENABLED=false
FXPRO_CLIENT_ID=
FXPRO_CLIENT_SECRET=
FXPRO_ACCOUNT_ID=
FXPRO_API_URL=https://connect.fxpro.com/api/v1

# Гипотетический счёт для расчёта P&L
ACCOUNT_BALANCE=250.0
LOT_SIZE=0.01
# ATR-scaled risk per trade в USD. 0 = отключить (fallback на LOT_SIZE).
# Default $15 = 1% от $1500 депо (Van K. Tharp 2007 ch.11).
RISK_PER_TRADE_USD=15.0
# Hard cap на ATR-scaled lot. Default 0.05 (safeguard после инцидента
# 23.04.2026 -$128/час, см. BUILDLOG.md). Поднимать только при осознанном
# user-acceptance высокого риска.
MAX_LOT_SIZE=0.05

# Whale-трекер
WHALE_COT_ENABLED=true
WHALE_SENTIMENT_ENABLED=false
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# Стратегия Leaders (copy-trading за китами)
LEADERS_ENABLED=true
LEADERS_MAX_POSITIONS=20
LEADERS_CAPITAL_PCT=0.67
LEADERS_SL_ATR=2.0
LEADERS_TRAIL_ATR=0.7

# Стратегия Outsiders (extreme setups)
OUTSIDERS_ENABLED=true
OUTSIDERS_MAX_POSITIONS=50
OUTSIDERS_CAPITAL_PCT=0.33
OUTSIDERS_MODE=confirmed

# Shadow analytics
SHADOW_ENABLED=true

# Скальпинг-стратегии
SCALPING_VWAP_ENABLED=true
SCALPING_STATARB_ENABLED=true
SCALPING_ORB_ENABLED=true
SCALPING_MAX_POSITIONS=50

# cTrader Open API (автоторговля)
CTRADER_TRADING_ENABLED=false
CTRADER_HOST_TYPE=demo
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=
CTRADER_REDIRECT_URI=https://openapi.ctrader.com/apps/token

# Kill Switch (защита от потерь)
KILLSWITCH_MAX_DAILY_LOSS=50.0
KILLSWITCH_MAX_DRAWDOWN_PCT=20.0
KILLSWITCH_MAX_POSITIONS=10
KILLSWITCH_MAX_LOSS_PER_TRADE=25.0

# ═══════════════════════════════════════════════════════════════
# FX AI TRADER (DeepSeek-V4 на cTrader FxPro: gold + Brent oil)
# ═══════════════════════════════════════════════════════════════
# Phase 1: paper-mode минимум 14 дней. Trading_enabled=false по умолчанию.
# Включать LIVE только после: подтверждённой стабильности парсера,
# калибровки sentiment-uncertainty gate, ≥30 paper-trades, ≥2-нед
# сбора данных в разных режимах (тренд/флет/новости) (sample-size.mdc).
#
# AI_FX_TRADER_TRADING_ENABLED=false
# AI_FX_TRADER_SYMBOLS=XAUUSD,BZ=F
# AI_FX_TRADER_ORDER_LABEL=ai-fx-trader   # broker-side изоляция от Advisor (label=fx-pro-bot)
# AI_FX_TRADER_POLL_INTERVAL_SEC=900      # full-cycle 15 мин
# AI_FX_TRADER_REVIEW_INTERVAL_SEC=300    # review-cycle 5 мин
# AI_FX_TRADER_VIRTUAL_CAPITAL=500
#
# KillSwitch v1.0 (12-May-2026, переработан на broker-safety only):
# LLM получил свободу discretionary trader — R:R / risk-per-trade /
# correlation он решает сам по setup'у (Mark Douglas / Van Tharp).
# Здесь только catastrophic-loss caps + broker margin safety.
# AI_FX_TRADER_MAX_DAILY_LOSS=150         # catastrophic, не tuning
# AI_FX_TRADER_MAX_TOTAL_LOSS=300         # halt эксперимент
# AI_FX_TRADER_MAX_POSITIONS=3            # broker margin safety / runaway-protection
# AI_FX_TRADER_MAX_POSITIONS_PER_SYMBOL=3 # = общий лимит (sanity)
# AI_FX_TRADER_MAX_LOT_SIZE=0.50          # broker margin floor (важно)
# NG MODE V2 (опционально, OFF по умолчанию): отдельные правила только
# для NG=F, чтобы уменьшить under-trading без изменения XAUUSD/BZ=F.
# AI_FX_TRADER_NG_MODE_V2_ENABLED=false
# AI_FX_TRADER_NG_MODE_V2_EVENT_HOURS=36
# AI_FX_TRADER_NG_MODE_V2_MAX_UNCERTAINTY=0.55
# BZ MOMENTUM MODE (опционально, OFF по умолчанию): paper-эксперимент —
# разрешает break->retest->hold continuation вход ТОЛЬКО по BZ=F в режиме
# повышенной волатильности (1H ATR% >= порога). XAUUSD/NG=F не меняются.
# Основание: scripts/ai_fx_hold_momentum_counterfactual.py (BZ bracket +0.29R
# vs XAU/NG flat-neg, n=25 <100). Включать = старт эксперимента с frozen
# params + OOS (см. BUILDLOG_AI_FX_TRADER.md).
# AI_FX_TRADER_BZ_BREAKOUT_MODE_ENABLED=false
# AI_FX_TRADER_BZ_BREAKOUT_MIN_ATR_PCT=0.6      # пол high-vol режима (calm ~0.2-0.4)
# AI_FX_TRADER_BZ_BREAKOUT_MIN_SL_ATR=2.0       # широкий стоп (1xATR чопает)
# AI_FX_TRADER_BZ_BREAKOUT_MAX_UNCERTAINTY=0.55
# Удалены в v1.0 (env vars игнорируются если выставлены):
# - AI_FX_TRADER_RISK_PER_TRADE_USD (LLM сам решает по Van Tharp R-multiple)
# - AI_FX_TRADER_CORRELATION_HAIRCUT (LLM сам решает аллокацию gold+oil)
#
# OAuth-токены изолированы от Advisor (отдельный файл и отдельный grant).
# Перед первым стартом — пройти fx-pro-auth и положить токены в этот
# файл. См. BUILDLOG_AI_FX_TRADER.md «token rotation hardening».
# AI_FX_TRADER_CTRADER_TOKEN_PATH=/data/ctrader_tokens_ai_fx.json
#
# LLM (DeepSeek через Anthropic-compat). Дефолтный max_tokens=8000:
# full-cycle output = thinking + commentary + JSON с multi-dim sentiment
# (~300–600 токенов). На 4096 наблюдался обрезанный JSON (12.05.2026).
# AI_FX_TRADER_DEEPSEEK_MAX_TOKENS=8000
# AI_FX_TRADER_DEEPSEEK_THINKING=true
# output_config.effort для DeepSeek-V4 Anthropic-compat endpoint:
# low | medium | high (default, рекомендовано) | max. Пустая строка
# отключает передачу (использовать default endpoint'а). См. BUILDLOG
# 2026-05-26 v4-prompt-tune для обоснования.
# AI_FX_TRADER_DEEPSEEK_EFFORT=high
#
# EIA Open Data (бесплатная регистрация на eia.gov — без ключа RSS-only).
# AI_FX_TRADER_EIA_API_KEY=
# AI_FX_TRADER_EIA_CACHE_TTL_SEC=21600     # 6 часов
#
# Macro rates feed (2026-05-27 D1): DXY (DX-Y.NYB) / UST10Y (^TNX) /
# TIPS ETF (TIP) через yfinance, без API-ключа. SYSTEM_PROMPT ссылается
# на эти ряды как primary gold-драйверы. Default = on; в тестах /
# при сбое yfinance — false. Cache 30 мин.
# AI_FX_TRADER_MACRO_RATES_ENABLED=true
# AI_FX_TRADER_MACRO_RATES_CACHE_TTL_SEC=1800
#
# ── Data-feed усиления (2026-05-29) ────────────────────────────────────
# B. FRED API key (бесплатно: fred.stlouisfed.org). С ключом macro_rates
#    добавляет ТОЧНЫЙ 10Y real yield (DFII10, gold-driver #1) + breakeven
#    (T10YIE). Без ключа → остаётся TIP-прокси через yfinance (degrade).
# AI_FX_TRADER_FRED_API_KEY=
#
# C. VIX risk-regime (yfinance ^VIX, без ключа). Gold safe-haven / oil
#    risk-off контекст. Default=on.
# AI_FX_TRADER_RISK_REGIME_ENABLED=true
# AI_FX_TRADER_RISK_REGIME_CACHE_TTL_SEC=1800
#
# A. CFTC COT positioning (public API, без ключа, weekly). Managed-money
#    net по gold/Brent/NG. Default=on, cache 6ч.
# AI_FX_TRADER_COT_ENABLED=true
# AI_FX_TRADER_COT_CACHE_TTL_SEC=21600
#
# D. GDELT news tone (public API, без ключа). Global media sentiment.
#    Default=on, cache 3ч (GDELT медленный/rate-limited → длинный TTL).
# AI_FX_TRADER_GDELT_ENABLED=true
# AI_FX_TRADER_GDELT_CACHE_TTL_SEC=10800
#
# E. Economic calendar (pure-compute, без сети/ключа). Event-proximity
#    FOMC/CPI/NFP/EIA. Default=on, окно 7 дней.
# AI_FX_TRADER_ECON_CALENDAR_ENABLED=true
# AI_FX_TRADER_ECON_CALENDAR_HORIZON_HOURS=168

# Live spot-price stream (Phase 1, 2026-05-29). Подписка на
# ProtoOASubscribeSpots → реальная цена вместо H1-close. Default=on.
# max_age_sec — backstop на молчащее соединение (фолбэк на M1-close).
# AI_FX_TRADER_LIVE_PRICE_ENABLED=true
# AI_FX_TRADER_LIVE_PRICE_MAX_AGE_SEC=300

# Event-driven review (Phase 2, 2026-05-29). Датчик locked-profit:
# будит внеплановый review когда позиция входит в зону >=threshold_r
# (по живой цене, без API). НЕ меняет exit-правила (решает LLM-guardian).
# threshold_r должен совпадать с locked-profit порогом промпта (1.5R).
# AI_FX_TRADER_EVENT_REVIEW_ENABLED=true
# AI_FX_TRADER_EVENT_REVIEW_THRESHOLD_R=1.5
# AI_FX_TRADER_EVENT_REVIEW_HYSTERESIS_R=0.3
# AI_FX_TRADER_EVENT_REVIEW_COOLDOWN_SEC=120
# AI_FX_TRADER_EVENT_REVIEW_SENSOR_INTERVAL_SEC=15
# AI_FX_TRADER_EVENT_REVIEW_MAX_PER_HOUR=6

# Event-driven FULL cycle (Phase 3, 2026-05-29). Будит аналитика по
# событиям: пробой Donchian-канала (вход) и движение против позиции
# (пересмотр тезиса). Плановый full остаётся страховкой. НЕ меняет
# правила входа/выхода — решает LLM.
# AI_FX_TRADER_EVENT_FULL_ENABLED=true
# AI_FX_TRADER_ENTRY_BREAKOUT_ENABLED=true
# AI_FX_TRADER_ENTRY_BREAKOUT_LOOKBACK=20
# AI_FX_TRADER_ENTRY_BREAKOUT_BUFFER_ATR=0.05
# AI_FX_TRADER_ENTRY_BREAKOUT_COOLDOWN_SEC=300
# AI_FX_TRADER_ENTRY_BREAKOUT_MAX_PER_HOUR=4
# AI_FX_TRADER_ADVERSE_MOVE_ENABLED=true
# AI_FX_TRADER_ADVERSE_MOVE_THRESHOLD_R=1.0
# AI_FX_TRADER_ADVERSE_MOVE_HYSTERESIS_R=0.3
# AI_FX_TRADER_ADVERSE_MOVE_COOLDOWN_SEC=300
# AI_FX_TRADER_ADVERSE_MOVE_MAX_PER_HOUR=4

# ============================================================================
# scalp_bot — orderflow-скальпер Bybit (rule-based, без LLM)
# Изолирован от ai_trader/bybit_bot. Решения по микроструктуре в реалтайме.
# ============================================================================
# SCALP_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Активные стратегии (CSV). Каждая ищет/сопровождает входы независимо;
# конфликт направлений по символу в один тик → тик пропускается.
# Доступно: sweep_fade, density_bounce.
# SCALP_ENABLED_STRATEGIES=sweep_fade,density_bounce
# density_bounce (отскок от плотности в стакане), research: Kalena 2026:
# SCALP_DENSITY_WALL_MULT=8.0          # стена ≥ 8× среднего уровня
# SCALP_DENSITY_ROUND_FRAC=0.001       # близость к круглому числу (0.1%)
# SCALP_DENSITY_PERSIST_SEC=10.0       # анти-спуфинг: выстоять до входа
# SCALP_DENSITY_ABSORB_FRAC=0.30       # съели ≥30% → снять (спуфинг)
# SCALP_DENSITY_ABSORB_WINDOW_SEC=10.0
# SCALP_DENSITY_NEAR_BPS=8.0           # вход когда цена ≤8 б.п. от стены
# SCALP_DENSITY_MIN_WALL_USD=0.0       # абс. пол стены (0 = только относит.)
# Bybit ключи (можно те же что у ai-trader, лучше отдельный subaccount):
# SCALP_BYBIT_API_KEY=
# SCALP_BYBIT_API_SECRET=
# SCALP_BYBIT_DEMO=true
# SCALP_BYBIT_CATEGORY=linear
# LIVE на demo (true, default, нужны ключи) | PAPER-симуляция (false):
# SCALP_TRADING_ENABLED=true
# post_only_limit (maker 0.02%) | market (taker 0.055%):
# SCALP_ENTRY_ORDER_TYPE=post_only_limit
# Капитал/лот (депо $1000, лот $100, минимум $10):
# SCALP_VIRTUAL_CAPITAL=1000
# SCALP_POSITION_USD=100
# SCALP_MIN_POSITION_USD=10
# SCALP_MAX_LEVERAGE=5
# SCALP_MAX_DAILY_LOSS_USD=500
# SCALP_MAX_TOTAL_LOSS_USD=800
# SCALP_MAX_OPEN_POSITIONS=2
# SCALP_MAX_TRADES_PER_HOUR=20
# Сигналы (research-based дефолты):
# SCALP_MIN_CONFLUENCE=3
# SCALP_FUNDING_EXTREME_POS=0.0005
# SCALP_FUNDING_EXTREME_NEG=0.0003
# SCALP_LIQ_FLUSH_USD=50000
# SCALP_OB_IMBALANCE_MIN=0.58
# SCALP_TIME_STOP_SEC=90
# SCALP_TAKE_PROFIT_R=2.0
# Двухфазный детектор свип-разворота (взвод → выстрел):
# SCALP_REQUIRE_RECLAIM=true
# SCALP_RECLAIM_FRAC=0.5
# SCALP_MOMENTUM_WINDOW_SEC=30
# SCALP_ARM_TIMEOUT_SEC=60
# SCALP_DIV_MIN_LATE_TRADES=4
# Fee-guard: цель ≥ N × round-trip издержек, иначе отброс:
# SCALP_ROUND_TRIP_FEE_FRAC=0.0011   # taker обе ноги (market-вход): 0.055%×2
# SCALP_MIN_TARGET_FEE_MULT=3.0
# Telegram (можно переиспользовать отдельного бота, напр. от ai_arena):
# SCALP_TELEGRAM_ENABLED=true
# SCALP_TELEGRAM_BOT_TOKEN=
# SCALP_TELEGRAM_CHAT_ID=

# ─── tradecard_bybit: advisory-ревьюер scalp_bot + flowzone_bot ──────────
# АНАЛИТИКА (не торговый бот, не автотюнер). Читает БД ботов read-only, считает
# SMB report card, грейдит по score, гоняет 5 Why через DeepSeek, отдаёт
# рекомендации человеку. НЕ меняет конфиг ботов и НЕ пишет в их БД.
# Запуск периодический: docker compose run --rm tradecard-bybit \
#   tradecard-bybit weekly --bot scalp
# TRADECARD_BYBIT_LOG_LEVEL=INFO
# 5 Why (DeepSeek, read-only). Дефолт ключа — общий DEEPSEEK_API_KEY.
# TRADECARD_BYBIT_FIVE_WHY_ENABLED=true
# TRADECARD_BYBIT_DEEPSEEK_API_KEY=
# TRADECARD_BYBIT_DEEPSEEK_MODEL=deepseek-v4-flash
# Bybit read-only (closedPnl ground truth). Свои ключи; дефолт — на ключи ботов.
# TRADECARD_BYBIT_SCALP_BYBIT_API_KEY=
# TRADECARD_BYBIT_SCALP_BYBIT_API_SECRET=
# TRADECARD_BYBIT_FLOWZONE_BYBIT_API_KEY=
# TRADECARD_BYBIT_FLOWZONE_BYBIT_API_SECRET=
# TRADECARD_BYBIT_CLOSED_PNL_ENABLED=true
# TRADECARD_BYBIT_MFE_ENABLED=false      # post-exit MFE (тянет klines)
# Telegram: раздельные конфиги, префиксы [tradecard-scalp]/[tradecard-flowzone].
# TRADECARD_BYBIT_SCALP_TELEGRAM_ENABLED=false
# TRADECARD_BYBIT_FLOWZONE_TELEGRAM_ENABLED=false
# Пороги наблюдения (НЕ торговые; нейтральные/относительные):
# TRADECARD_BYBIT_MIN_TRADES_FOR_THEME=100
# TRADECARD_BYBIT_GRADE_MONOTONIC_MIN_RHO=0.5
# TRADECARD_BYBIT_SL_CLUSTER_FACTOR=1.5

# ─── ru_stocks_analyst: советник акций MOEX (Tinkoff, только Telegram) ───
# README: README_RU_STOCKS.md | discover: ru-stocks-discover
# RU_STOCKS_TINKOFF_TOKEN=
# RU_STOCKS_ACCOUNT_ID=          # брокерский (не ИИС); пусто = авто
# RU_STOCKS_TELEGRAM_BOT_TOKEN=
# RU_STOCKS_TELEGRAM_CHAT_ID=
# RU_STOCKS_UNIVERSE_TOP_N=50
# RU_STOCKS_POLL_INTERVAL_SEC=3600
# RU_STOCKS_NEWS_ENABLED=true
# RU_STOCKS_LLM_ENABLED=true          # нужен DEEPSEEK_API_KEY в .env
# RU_STOCKS_NEWS_MAX_AGE_HOURS=36
# RU_STOCKS_DRY_RUN=false

# ============================================================================
# fx_momentum_bot — полностью изолированный FX momentum бот
# (отдельные MOMENTUM_BOT_* переменные, своя БД и токены)
# ============================================================================
# MOMENTUM_BOT_LOG_LEVEL=INFO
# MOMENTUM_BOT_TRADING_ENABLED=false
# MOMENTUM_BOT_POLL_INTERVAL_SEC=300
# MOMENTUM_BOT_SYMBOLS=EURUSD=X,GBPUSD=X,USDJPY=X,AUDUSD=X
# MOMENTUM_BOT_YFINANCE_INTERVAL=1h
# MOMENTUM_BOT_YFINANCE_PERIOD=3mo
# MOMENTUM_BOT_LOOKBACK_BARS=24
# MOMENTUM_BOT_ATR_PERIOD=14
# MOMENTUM_BOT_ATR_STOP_MULT=2.5
# MOMENTUM_BOT_ATR_TAKE_MULT=3.5
# MOMENTUM_BOT_SIGNAL_THRESHOLD=0.0015
# MOMENTUM_BOT_LOT_SIZE=0.01
# MOMENTUM_BOT_MAX_OPEN_POSITIONS=3
# MOMENTUM_BOT_ORDER_LABEL=momentum-bot
# Trader-backed management: Van Tharp (BE via R-multiples),
# Linda Raschke (partial + runner), Turtle/LeBeau ATR trailing.
# MOMENTUM_BOT_POSITION_MANAGEMENT_ENABLED=true
# MOMENTUM_BOT_BREAK_EVEN_R=1.0
# MOMENTUM_BOT_PARTIAL_TAKE_R=1.5
# MOMENTUM_BOT_PARTIAL_TAKE_FRACTION=0.5
# MOMENTUM_BOT_TRAILING_ACTIVATE_R=1.5
# MOMENTUM_BOT_TRAILING_ATR_MULT=1.5
#
# MOMENTUM_BOT_CTRADER_HOST_TYPE=demo
# MOMENTUM_BOT_CTRADER_CLIENT_ID=
# MOMENTUM_BOT_CTRADER_CLIENT_SECRET=
# MOMENTUM_BOT_CTRADER_ACCOUNT_ID=
# MOMENTUM_BOT_CTRADER_REDIRECT_URI=https://openapi.ctrader.com/apps/token
# MOMENTUM_BOT_TOKEN_SERVICE_URL=http://ctrader-token-service:8080
# MOMENTUM_BOT_TOKEN_SERVICE_SECRET=
# MOMENTUM_BOT_TOKEN_SERVICE_LABEL=momentum_bot
# MOMENTUM_BOT_REQUIRE_TOKEN_SERVICE=true
#
# MOMENTUM_BOT_DATA_DIR=/data
# MOMENTUM_BOT_DB_FILENAME=momentum_bot.sqlite
# MOMENTUM_BOT_TOKEN_FILENAME=momentum_bot_tokens.json
